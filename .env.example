# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repozytorium.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bugtracker
DB_USER=bugtracker
DB_PASSWORD=
# Wygeneruj: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
SECRET_KEY=
# Opcjonalnie: true włącza /docs (Swagger) lokalnie
ENABLE_DOCS=false
